# ─────────────────────────────────────────────────────────────────────────────
# HealNet AI — Environment Configuration
# Copy this file to .env and fill in your values.
# For Streamlit Cloud, add these as Secrets (TOML format).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Primary Database) ───────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
SUPABASE_URL=https://vuqwwimpmafdnqxdvdfu.supabase.co
SUPABASE_KEY=sb_publishable_mh9N0M2XxE62WUOvhe7tJA_byErRCFl

# ── Optional: Force SQLite fallback (for local dev without Supabase) ──────────
# DB_FALLBACK=1

# ── Security ──────────────────────────────────────────────────────────────────
# Used for password hashing fallback when bcrypt is not installed
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Gmail Alerts ──────────────────────────────────────────────────────────────
# The sender email is currently hardcoded in app.py; move it here for safety
SENDER_EMAIL=your-gmail@gmail.com
SENDER_PASSWORD=your-app-password

# ── IoT Configuration ─────────────────────────────────────────────────────────
# How many seconds old a DB vitals row can be before falling back to simulation
IOT_POLL_SECONDS=30
